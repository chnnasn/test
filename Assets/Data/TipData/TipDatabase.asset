  _tips:
  - "\u50F5\u5C38\u4F3C\u4E4E\u88AB\u67D0\u79CD\u529B\u91CF\u6709\u7EC4\u7EC7\u5730\u64CD\u63A7\u7740\uFF0C\u4E00\u6CE2\u63A5\u4E00\u6CE2\uFF0C\u6C38\u4E0D\u505C\u6B47"
  - "\u6CA1\u6709\u4EBA\u77E5\u9053\u4F20\u9001\u95E8\u7684\u53E6\u4E00\u8FB9\u662F\u4EC0\u4E48\u3002\u4E5F\u8BB8\u53EA\u6709\u901A\u5173\u7684\u4EBA\u624D\u6709\u8D44\u683C\u7AA5\u89C1\u7B54\u6848"
  - "\u50F5\u5C38\u4F3C\u4E4E\u88AB\u67D0\u79CD\u529B\u91CF\u6709\u7EC4\u7EC7\u5730\u64CD\u63A7\u7740\uFF0C\u8FD9\u610F\u5473\u7740\u5B83\u4EEC\u4F1A\u4ECE\u56DB\u9762\u516B\u65B9\u56F4\u8FC7\u6765"
  - "\u6BCF\u6B21+5%\u4F24\u5BB3\u51CF\u514D\uFF0C\u867D\u7136\u5355\u6B21\u63D0\u5347\u4E0D\u5927\uFF0C\u4F46\u7D2F\u8BA1\u5230\u540E\u671F\u975E\u5E38\u6297\u63CD"
  - "\u7B2C15\u6CE2\u6709150\u53EA\u50F5\u5C38\uFF0C3\u4E2A\u4F20\u9001\u95E8\u540C\u6B65\u51FA\u602A\uFF0C\u8BF7\u63D0\u524D\u505A\u597D\u51C6\u5907"
  - "\u666E\u901A\u50F5\u5C38\u3001\u6500\u722C\u50F5\u5C38\u548C\u81EA\u7206\u50F5\u5C38\u3002\u81EA\u7206\u50F5\u5C38\u6B7B\u4EA1\u65F6\u4F1A\u9020\u6210\u8303\u56F4\u4F24\u5BB3\uFF0C\u52A1\u5FC5\u4FDD\u6301\u8DDD\u79BB"
  - "\u6BCF\u6B21\u5347\u7EA7\u4ECE3\u4E2A\u968F\u673ABuff\u4E2D\u9009\u4E00\u4E2A\uFF0C\u6BCF\u79CD\u53EA\u80FD\u62FF\u4E00\u6B21\uFF0C\u5148\u5230\u5148\u5F97\uFF01"
  - "\u6362\u5F39\u662F\u50F5\u5C38\u552F\u4E00\u80FD\u8FFD\u4E0A\u4F60\u7684\u77AC\u95F4\u3002\u7F29\u77ED\u5B83"
  - "\u9632\u5F39\u8863\u7A7F\u5728\u91CC\u9762\uFF0C\u8C26\u865A\u662F\u4E00\u79CD\u751F\u5B58\u7B56\u7565"
  - "\u6495\u5F00\u5305\u88C5\uFF0C\u6D3B\u4E0B\u53BB\u7684\u7406\u7531\u53C8\u591A\u4E86\u4E00\u4E2A"
  - "\u9000\u4E00\u6B65\u4E0D\u662F\u9003\u8DD1\uFF0C\u662F\u6362\u4E2A\u89D2\u5EA6\u5F00\u67AA"
  - "\u51BB\u4F4F\u5B83\u4EEC\u7684\u817F\uFF0C\u4F60\u7684\u5B50\u5F39\u5C31\u6709\u4E86\u66F4\u591A\u65F6\u95F4\u81EA\u6211\u4ECB\u7ECD"
  - "\u67AA\u53E3\u8DF3\u5F97\u8D8A\u5C11\uFF0C\u5B50\u5F39\u843D\u5728\u8138\u4E0A\u7684\u8D8A\u591A"
